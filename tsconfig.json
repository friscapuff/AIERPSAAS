{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "lib": ["ES2021"],
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./",
    "strict": false,
    "strictPropertyInitialization": false,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "baseUrl": "./",
    "paths": {
      "@app/*": ["apps/api/src/*"],
      "@app/modules/*": ["apps/api/src/modules/*"],
      "@app/common/*": ["apps/api/src/common/*"],
      "@libs/shared": ["libs/shared/src"],
      "@libs/shared/*": ["libs/shared/src/*"],
      "@libs/database": ["libs/database/src"],
      "@libs/database/*": ["libs/database/src/*"],
      "@libs/logger": ["libs/logger/src"],
      "@libs/logger/*": ["libs/logger/src/*"],
      "@libs/auth": ["libs/auth/src"],
      "@libs/auth/*": ["libs/auth/src/*"],
      "@libs/validation": ["libs/validation/src"],
      "@libs/validation/*": ["libs/validation/src/*"]
    },
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "sourceMap": true
  },
  "include": ["apps/api/**/*", "apps/worker/**/*", "libs/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist", "apps/web", "**/*.spec.ts", "**/*.e2e-spec.ts"]
}
