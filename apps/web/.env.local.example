# Copy this file to .env.local and fill in values

# Backend API base URL (server-side and rewrites destination)
NEXT_PUBLIC_API_URL=http://localhost:3001

# App metadata
NEXT_PUBLIC_APP_NAME=AiERP
NEXT_PUBLIC_APP_VERSION=1.0.0

# JWT secrets (used only for client-side decode -- never put signing secret here)
NEXT_PUBLIC_TOKEN_KEY=aierp_access_token
NEXT_PUBLIC_REFRESH_TOKEN_KEY=aierp_refresh_token
